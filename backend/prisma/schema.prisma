generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  AC_MASTER
  NON_AC_MASTER
}

enum TableType {
  AC
  NON_AC
}

enum MenuType {
  AC
  NON_AC
  SWIGGY
  ZOMATO
}

enum OrderSource {
  DINE_IN_AC
  DINE_IN_NON_AC
  SELF_PICKUP
  SWIGGY
  ZOMATO
}

enum Permission {
  DASHBOARD_VIEW
  TABLE_VIEW
  TABLE_CREATE
  TABLE_EDIT
  TABLE_DELETE
  TABLE_CHANGE
  MENU_AC_VIEW
  MENU_AC_CREATE
  MENU_AC_EDIT
  MENU_AC_DELETE
  MENU_NON_AC_VIEW
  MENU_NON_AC_CREATE
  MENU_NON_AC_EDIT
  MENU_NON_AC_DELETE
  MENU_SWIGGY_VIEW
  MENU_SWIGGY_CREATE
  MENU_SWIGGY_EDIT
  MENU_SWIGGY_DELETE
  MENU_ZOMATO_VIEW
  MENU_ZOMATO_CREATE
  MENU_ZOMATO_EDIT
  MENU_ZOMATO_DELETE
  MENU_BULK_ADD
  ORDER_CREATE
  ORDER_EDIT
  ORDER_CANCEL
  KOT_CREATE
  KOT_VIEW
  KOT_EDIT
  KOT_PRINT
  BILL_VIEW_DRAFT
  BILL_EDIT
  BILL_PRINT
  BILL_FINALIZE
  BILL_CANCEL
  BILL_AMEND
  PURCHASE_VIEW
  PURCHASE_CREATE
  PURCHASE_EDIT
  PURCHASE_DELETE
  INVENTORY_VIEW
  INVENTORY_CREATE
  INVENTORY_EDIT
  INVENTORY_ADJUST
  REPORT_VIEW
  REPORT_PDF
  REPORT_CSV
  USER_VIEW
  USER_CREATE
  USER_EDIT
  USER_DELETE
  SETTINGS_VIEW
  SETTINGS_EDIT
  ONLINE_ORDER_VIEW
  ONLINE_ORDER_CREATE
  ONLINE_ORDER_EDIT
  NOTIFICATION_KOT_AC
  NOTIFICATION_KOT_NON_AC
  NOTIFICATION_BILL_AC
  NOTIFICATION_BILL_NON_AC
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILLING
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  SENT
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum KotStatus {
  NEW
  PREPARING
  READY
  SERVED
  COMPLETED
}

enum BillStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum OnlinePlatform {
  SWIGGY
  ZOMATO
}

enum OnlineOrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OnlinePaymentStatus {
  PAID
  PENDING
  SETTLED
  REFUNDED
}

enum InventoryTransactionType {
  PURCHASE
  PURCHASE_REVERSAL
  MANUAL_ADJUSTMENT
  SALE
  SALE_REVERSAL
}

enum ChangeType {
  EDITED
  CANCELLED
}

// ─── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  sessions      TableSession[]
  orders        Order[]
  permissions   UserPermission[]
}

model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission
  createdAt  DateTime   @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  // JWT refresh tokens carry id + jti + iat + exp and run ~247 chars. The MySQL
  // default for String is VARCHAR(191), which silently truncates them (or errors
  // with 1406 under strict mode) — 512 keeps the unique index within InnoDB's
  // 3072-byte key limit at utf8mb4 (512 * 4 = 2048).
  token     String   @unique @db.VarChar(512)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Table {
  id        String      @id @default(uuid())
  number    Int         @unique
  capacity  Int         @default(4)
  type      TableType
  status    TableStatus @default(AVAILABLE)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  sessions TableSession[]
  orders   Order[]

  @@index([type])
  @@index([status])
}

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  displayOrder Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  menuItems MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  menuType    MenuType
  price       Decimal  @db.Decimal(10, 2)
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional link to a stock item: ordering this menu item deducts the same quantity from inventory
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@unique([name, categoryId, menuType])
  @@index([menuType])
  @@index([categoryId])
  @@index([active])
  @@index([menuType, active])
  @@index([categoryId, active])
  @@index([inventoryItemId])
}

model TableSession {
  id         String        @id @default(uuid())
  tableId    String
  table      Table         @relation(fields: [tableId], references: [id])
  captainId  String
  captain    User          @relation(fields: [captainId], references: [id])
  guestCount Int?
  status     SessionStatus @default(OPEN)
  openedAt   DateTime      @default(now())
  closedAt   DateTime?

  orders Order[]
  kots   KOT[]
  bills  Bill[]

  @@index([tableId])
  @@index([captainId])
  @@index([status])
  @@index([tableId, status])
  @@index([status, openedAt])
}

model Order {
  id          String        @id @default(uuid())
  orderSource OrderSource   @default(DINE_IN_NON_AC)
  sessionId   String?
  session     TableSession? @relation(fields: [sessionId], references: [id])
  tableId     String?
  table       Table?        @relation(fields: [tableId], references: [id])
  captainId   String
  captain     User          @relation(fields: [captainId], references: [id])
  status      OrderStatus   @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items OrderItem[]
  kots  KOT[]
  bill  Bill?

  @@index([orderSource])
  @@index([status])
  @@index([createdAt])
  @@index([sessionId])
  @@index([tableId])
  @@index([captainId])
  @@index([status, createdAt])
  @@index([sessionId, status])
  @@index([tableId, status])
}

model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id])
  menuItemId       String
  menuItem         MenuItem        @relation(fields: [menuItemId], references: [id])
  itemNameSnapshot String
  priceSnapshot    Decimal         @db.Decimal(10, 2)
  quantity         Int
  originalQuantity Int?
  notes            String?
  kotId            String?
  kot              KOT?            @relation(fields: [kotId], references: [id])
  status           OrderItemStatus @default(PENDING)
  createdAt        DateTime        @default(now())

  history OrderItemHistory[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([kotId])
  @@index([status])
  @@index([orderId, status])
  @@index([kotId, status])
}

model OrderItemHistory {
  id          String     @id @default(uuid())
  orderItemId String
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id])
  changeType  ChangeType
  oldQuantity Int
  newQuantity Int
  reason      String?
  changedBy   String
  createdAt   DateTime   @default(now())

  @@index([orderItemId])
}

model KOT {
  id          String        @id @default(uuid())
  kotNumber   Int
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  sessionId   String?
  session     TableSession? @relation(fields: [sessionId], references: [id])
  captainId   String
  status      KotStatus     @default(NEW)
  // Table number when the KOT was raised — stays as printed even if the order later moves table
  tableNumber Int?
  createdAt   DateTime      @default(now())

  items OrderItem[]

  @@index([orderId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Bill {
  id            String        @id @default(uuid())
  billNumber    Int           @unique @default(autoincrement())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  sessionId     String?
  session       TableSession? @relation(fields: [sessionId], references: [id])
  tableId       String?
  customerName  String?
  customerPhone String?
  subtotal      Decimal       @db.Decimal(10, 2)
  sgstPercent   Decimal       @default(2.50) @db.Decimal(5, 2)
  cgstPercent   Decimal       @default(2.50) @db.Decimal(5, 2)
  sgstAmount    Decimal       @default(0.00) @db.Decimal(10, 2)
  cgstAmount    Decimal       @default(0.00) @db.Decimal(10, 2)
  discount      Decimal       @default(0.00) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  roundOff      Decimal       @default(0.00) @db.Decimal(10, 2)
  version       Int           @default(1)
  status        BillStatus    @default(DRAFT)
  createdAt     DateTime      @default(now())
  finalizedAt   DateTime?

  payment    Payment?
  amendments BillAmendment[]

  @@index([status])
  @@index([createdAt])
  @@index([sessionId])
  @@index([tableId])
  @@index([status, createdAt])
  @@index([createdAt, status])
  @@index([tableId, status])
}

model BillAmendment {
  id            String   @id @default(uuid())
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id])
  version       Int
  changes       Json
  reason        String
  modifiedBy    String
  originalTotal Decimal  @db.Decimal(10, 2)
  newSubtotal   Decimal  @db.Decimal(10, 2)
  newSgstAmount Decimal  @db.Decimal(10, 2)
  newCgstAmount Decimal  @db.Decimal(10, 2)
  newDiscount   Decimal  @default(0.00) @db.Decimal(10, 2)
  newTotal      Decimal  @db.Decimal(10, 2)
  difference    Decimal  @db.Decimal(10, 2)
  paymentStatus String   @default("PENDING")
  createdAt     DateTime @default(now())

  @@index([billId])
}

model Payment {
  id     String        @id @default(uuid())
  billId String        @unique
  bill   Bill          @relation(fields: [billId], references: [id])
  method PaymentMethod
  amount Decimal       @db.Decimal(10, 2)
  status PaymentStatus @default(PAID)
  paidAt DateTime      @default(now())

  @@index([paidAt])
  @@index([method])
  @@index([status, paidAt])
}

model OnlineOrder {
  id              String              @id @default(uuid())
  platform        OnlinePlatform
  externalOrderId String
  customerName    String?
  items           Json
  subtotal        Decimal             @db.Decimal(10, 2)
  discount        Decimal             @default(0.00) @db.Decimal(10, 2)
  charges         Decimal             @default(0.00) @db.Decimal(10, 2)
  total           Decimal             @db.Decimal(10, 2)
  paymentStatus   OnlinePaymentStatus @default(PAID)
  status          OnlineOrderStatus   @default(NEW)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([platform])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([platform, status])
}

model Supplier {
  id        String          @id @default(uuid())
  name      String
  phone     String?
  address   String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  purchases PurchaseEntry[]
}

model PurchaseEntry {
  id             String         @id @default(uuid())
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  purchaseNumber String?
  totalAmount    Decimal        @db.Decimal(10, 2)
  purchaseDate   DateTime
  addToInventory Boolean        @default(false)
  status         String         @default("ACTIVE")
  createdAt      DateTime       @default(now())

  items PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
  @@index([status, purchaseDate])
  @@index([supplierId, purchaseDate])
}

model PurchaseItem {
  id         String        @id @default(uuid())
  purchaseId String
  purchase   PurchaseEntry @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  name       String
  quantity   Decimal       @db.Decimal(10, 2)
  unit       String
  rate       Decimal       @db.Decimal(10, 2)
  amount     Decimal       @db.Decimal(10, 2)

  @@index([purchaseId])
}

model InventoryItem {
  id                String   @id @default(uuid())
  name              String   @unique
  currentStock      Decimal  @db.Decimal(10, 2)
  unit              String
  lowStockThreshold Decimal  @default(0.00) @db.Decimal(10, 2)
  updatedAt         DateTime @updatedAt

  transactions InventoryTransaction[]
  menuItems    MenuItem[]
}

model InventoryTransaction {
  id              String                   @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem            @relation(fields: [inventoryItemId], references: [id])
  type            InventoryTransactionType
  quantity        Decimal                  @db.Decimal(10, 2)
  referenceId     String?
  notes           String?
  createdAt       DateTime                 @default(now())

  @@index([inventoryItemId])
  @@index([type])
  @@index([createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([referenceId])
}

model Settings {
  id                        String   @id @default(uuid())
  restaurantName            String   @default("Maharaj Veg Villa")
  address                   String?
  phone                     String?
  gstin                     String?
  sgstPercent               Decimal  @default(2.50) @db.Decimal(5, 2)
  cgstPercent               Decimal  @default(2.50) @db.Decimal(5, 2)
  includePurchasesInReports Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
